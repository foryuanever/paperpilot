{
  "manifest_version": 3,
  "name": "PaperSolver Capture",
  "version": "0.3.8",
  "description": "在论文官网、数据库详情页和 PDF 页面识别文献信息，并一键导入 PaperSolver。",
  "icons": {
    "128": "icon-active-128.png"
  },
  "permissions": ["storage", "notifications", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.sciencedirect.com/*",
    "https://*.sciencedirect.com/*",
    "https://pdf.sciencedirectassets.com/*",
    "https://www.semanticscholar.org/*",
    "https://*.semanticscholar.org/*",
    "https://pubmed.ncbi.nlm.nih.gov/*",
    "https://www.ncbi.nlm.nih.gov/*",
    "https://*.ncbi.nlm.nih.gov/*",
    "https://www.webofscience.com/*",
    "https://*.webofscience.com/*",
    "https://www.cnki.net/*",
    "https://*.cnki.net/*",
    "https://www.wanfangdata.com.cn/*",
    "https://*.wanfangdata.com.cn/*",
    "https://www.researchrabbit.ai/*",
    "https://*.researchrabbit.ai/*",
    "https://www.connectedpapers.com/*",
    "https://*.connectedpapers.com/*",
    "https://scholar.google.com/*",
    "https://arxiv.org/*",
    "https://aclanthology.org/*",
    "https://*.aclanthology.org/*",
    "https://ieeexplore.ieee.org/*",
    "https://*.ieeexplore.ieee.org/*",
    "https://link.springer.com/*",
    "https://*.springer.com/*",
    "https://www.nature.com/*",
    "https://*.nature.com/*",
    "https://dl.acm.org/*",
    "https://doi.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon-active-128.png", "icon-gray-128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://www.sciencedirect.com/*",
        "https://*.sciencedirect.com/*",
        "https://pdf.sciencedirectassets.com/*",
        "https://www.semanticscholar.org/*",
        "https://*.semanticscholar.org/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://www.ncbi.nlm.nih.gov/*",
        "https://*.ncbi.nlm.nih.gov/*",
        "https://www.webofscience.com/*",
        "https://*.webofscience.com/*",
        "https://www.cnki.net/*",
        "https://*.cnki.net/*",
        "https://www.wanfangdata.com.cn/*",
        "https://*.wanfangdata.com.cn/*",
        "https://www.researchrabbit.ai/*",
        "https://*.researchrabbit.ai/*",
        "https://www.connectedpapers.com/*",
        "https://*.connectedpapers.com/*",
        "https://scholar.google.com/*",
        "https://arxiv.org/*",
        "https://aclanthology.org/*",
        "https://*.aclanthology.org/*",
        "https://ieeexplore.ieee.org/*",
        "https://*.ieeexplore.ieee.org/*",
        "https://link.springer.com/*",
        "https://*.springer.com/*",
        "https://www.nature.com/*",
        "https://*.nature.com/*",
        "https://dl.acm.org/*",
        "https://doi.org/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PaperSolver Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon-gray-128.png"
    }
  }
}
