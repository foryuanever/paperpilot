# 桌面端连接的云端后端地址。
# 本地测试可以用:
# PAPER_SOLVER_API_BASE=http://127.0.0.1:8080
#
# 正式打包时改成你的线上后端，例如:
# PAPER_SOLVER_API_BASE=https://api.papersolver.cn
PAPER_SOLVER_API_BASE=http://127.0.0.1:8080

# PaperSolver 本机依赖包下载地址。
# 没有配置时，客户端会尝试使用默认平台包地址：
# https://download.papersolver.cn/dependencies/papersolver-local-dependency-{platform}-{arch}.zip
# 你也可以换成自己的 OSS/COS/服务器直链。
# PAPER_SOLVER_DEPENDENCY_URL=https://download.papersolver.cn/dependencies/papersolver-local-dependency-macos-arm64.zip
