# 桌面端连接的云端后端地址。
# 本地测试可以用:
# PAPER_SOLVER_API_BASE=http://127.0.0.1:8080
#
# 正式打包时改成你的线上后端，例如:
# PAPER_SOLVER_API_BASE=https://api.papersolver.cn
PAPER_SOLVER_API_BASE=http://127.0.0.1:8080

# PaperSolver 本机能力安装清单。
# 正式发布建议只把这个小清单放到 papersolver.cn，大文件 URL 写在清单里。
# PAPER_SOLVER_DEPENDENCY_MANIFEST=https://papersolver.cn/downloads/dependencies/dependency-manifest.json
#
# 兼容旧版单包下载地址；只有清单不可用时才会使用。
# PAPER_SOLVER_DEPENDENCY_URL=https://papersolver.cn/downloads/dependencies/papersolver-local-dependency-macos-arm64.zip
