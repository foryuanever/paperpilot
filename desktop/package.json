{
  "name": "papersolver-desktop",
  "version": "2.2.0",
  "private": true,
  "description": "PaperSolver desktop shell",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node scripts/build-front.mjs && electron .",
    "start": "electron .",
    "build:front": "node scripts/build-front.mjs",
    "prepare:dependency": "node scripts/prepare-local-dependency-source.mjs",
    "prepare:runtime": "node scripts/prepare-offline-runtime.mjs",
    "prepare:models": "node scripts/prepare-offline-models.mjs",
    "audit:dependency": "node scripts/audit-offline-dependency.mjs",
    "build:dependency": "node scripts/package-local-dependency.mjs",
    "test:release": "node scripts/release-smoke-test.mjs",
    "test:translation-load": "node scripts/translation-load-test.mjs",
    "pack": "node scripts/build-front.mjs && electron-builder --dir",
    "dist": "node scripts/build-front.mjs && electron-builder",
    "dist:mac": "node scripts/build-front.mjs && electron-builder --mac dmg zip --arm64",
    "dist:win": "node scripts/build-front.mjs && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.clingy.papersolver",
    "productName": "PaperSolver",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "src/**/*",
      "dependency-service/pdf/server.py",
      "front-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "dependency-service/structured/pdftext-0.6.3",
        "to": "compat/pdftext-0.6.3"
      },
      {
        "from": "dependency-service/structured/formula-compat",
        "to": "compat/formula",
        "filter": [
          "ftfy/**/*",
          "ftfy-6.3.1.dist-info/**/*",
          "wcwidth/**/*",
          "wcwidth-0.8.2.dist-info/**/*",
          "formula-smoke.pdf"
        ]
      },
      {
        "from": "dependency-service/structured/fasttext/lid.176.ftz",
        "to": "compat/fasttext/lid.176.ftz"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://papersolver.cn/downloads/"
      }
    ],
    "protocols": [
      {
        "name": "PaperSolver OAuth",
        "schemes": [
          "papersolver"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PaperSolver"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
