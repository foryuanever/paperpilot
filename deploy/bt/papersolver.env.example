# PaperSolver production environment.
# Copy this file to /etc/papersolver/papersolver.env on the server and fill values.

SERVER_PORT=8080
PAPERPILOT_SESSION_SECRET=replace-with-a-random-64-character-secret
PAPERPILOT_QQ_APP_ID=
PAPERPILOT_QQ_APP_SECRET=
PAPERPILOT_QQ_REDIRECT_URI=https://papersolver.cn/api/auth/qq/callback
# Keep false in production. Demo users and sample data must never be recreated after deletion.
PAPERPILOT_DEMO_SEED=false
# Comma/space-separated desktop machine IDs allowed to bind multiple QQ accounts.
# Leave empty to enforce one QQ account per machine.
PAPERPILOT_PRIVILEGED_MACHINE_IDS=adc9d51ef1b4aa4d52eedcfee6132db46f998a9b8343af87abb6ee008a4ce98c
PAPERPILOT_WECHAT_APP_ID=
PAPERPILOT_WECHAT_APP_SECRET=

# Database
PAPER_DB_HOST=127.0.0.1
PAPER_DB_PORT=3306
PAPER_DB_NAME=paper
PAPER_DB_USERNAME=root
PAPER_DB_PASSWORD=change-me

# Public origin
PAPERPILOT_PUBLIC_BASE_URL=https://papersolver.cn

# WeChat Pay API v3
PAPERPILOT_WECHAT_PAY_APP_ID=wxd84d54269bfdf677
PAPERPILOT_WECHAT_PAY_MCH_ID=1748953326
PAPERPILOT_WECHAT_PAY_SERIAL_NO=2204B643BB2B207B0B8DCEA66F1DE8C5CA84D662
PAPERPILOT_WECHAT_PAY_API_V3_KEY=replace-with-new-api-v3-key
PAPERPILOT_WECHAT_PAY_PRIVATE_KEY_PATH=/www/wwwroot/papersolver/certs/apiclient_key.pem
PAPERPILOT_WECHAT_PAY_NOTIFY_URL=https://papersolver.cn/api/payments/notify/wechat

# Optional translation engines
BAIDU_APP_ID=
BAIDU_SECRET=
MICROSOFT_TRANSLATOR_KEY=
MICROSOFT_TRANSLATOR_REGION=eastasia
TENCENT_TRANSLATE_SECRET_ID=
TENCENT_TRANSLATE_SECRET_KEY=
TENCENT_TRANSLATE_REGION=ap-guangzhou

# Local PDF services
PDFMATH_TRANSLATE_URL=http://127.0.0.1:11008
MINERU_BINARY=/www/server/papersolver/.mineru-venv/bin/mineru
MINERU_MODEL_SOURCE=modelscope

# PPT generation
PPT_MASTER_SKILL_DIR=/www/wwwroot/ppt-master-runtime
PPT_MASTER_PYTHON=/www/wwwroot/.ppt-master-venv/bin/python
PPT_MASTER_CODEX=/usr/local/bin/codex
PPT_MASTER_CODEX_HOME=/www/wwwroot/.papersolver-codex
PPT_MASTER_AGENT_TIMEOUT_MINUTES=120
